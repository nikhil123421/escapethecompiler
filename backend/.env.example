# ── Supabase Database Configuration ───────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Server Key (supports both new sb_secret_... and legacy service_role eyJ...)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=

# ── App Security ─────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_TTL_HOURS=12

# Passcode to log in to the /admin organizer dashboard
ORGANIZER_PASSCODE=ETC-ADMIN-2026

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# Repository mode: "supabase" (live database) or "memory" (demo RAM mode)
REPOSITORY=supabase

# Node binary path
NODE_BINARY=node
